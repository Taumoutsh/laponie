# --- Accès à l'application ---
# Mot de passe demandé à l'ouverture. Laisser vide pour désactiver la protection.
APP_PASSWORD=change-moi
# Secret utilisé pour signer le cookie de session (une longue chaîne aléatoire).
# Ex. : openssl rand -hex 32
SESSION_SECRET=remplace-par-une-longue-chaine-aleatoire

# --- Base de données (conteneur PostgreSQL du docker-compose) ---
# Lettres et chiffres uniquement : le mot de passe est repris tel quel dans DATABASE_URL.
POSTGRES_USER=laponie
POSTGRES_PASSWORD=changeme
POSTGRES_DB=laponie

# --- Sauvegardes automatiques ---
# Dossier de l'hôte où sont écrites les sauvegardes.
BACKUP_PATH=./backups
# Nombre de sauvegardes conservées (les plus anciennes sont supprimées).
BACKUP_KEEP=14
# Intervalle entre deux sauvegardes, en heures.
BACKUP_INTERVAL_HOURS=24

# --- Réseau Nginx Proxy Manager ---
# Nom du réseau Docker externe sur lequel tourne Nginx Proxy Manager.
# Vérifier avec : docker network ls
NPM_NETWORK=npm_default

# --- Développement local uniquement (hors Docker) ---
# DATABASE_URL=postgresql://laponie:changeme@localhost:5432/laponie?schema=public
